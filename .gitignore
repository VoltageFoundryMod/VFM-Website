# Hugo build output and caches
/public/
/resources/_gen/
.hugo_build.lock

# Module repos cloned at build time by sync_manuals.py, for whichever repos you
# don't have a sibling checkout of. Never committed — pulled fresh each build.
/modules/

# Generated at build time by sync_manuals.py from the cloned module repos.
# Never commit these — they are regenerated on every deploy.
/content/modules/
/static/panels/
/static/modules/
